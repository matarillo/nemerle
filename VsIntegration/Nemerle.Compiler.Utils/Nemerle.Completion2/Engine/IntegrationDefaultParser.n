using Nemerle.Compiler;
using Nemerle.Utility;

namespace Nemerle.Compiler.Utils
{
  [Record]
  internal sealed class IntegrationDefaultParser : IParser
  {
    manager : ManagerClass;

    public Parse(source : ISource) : ParseResult
    {
      def lexer = LexerString(manager, source.GetText(), Location(source.FileIndex, 1, 1));
      when(manager.Options.IndentationSyntax)
        lexer.SwitchToIndentationMode();
      // allowTopLevelExpressions: parse top-level-expression programs the same
      // way the batch compiler does (synthetic Main class) instead of the
      // historical IntelliSense-mode behavior of reporting "expecting type
      // declaration" on them (WP-N2 / R-P parser parity).
      DefaultParseResult(MainParser.Parse(lexer, null, true), lexer)
    }
  }
}
