using System.Console;
using Nemerle.Assertions;
using Nemerle.IO;

module M
{
  TestNotNullOrEmpty([NotNullOrEmpty] s : string) : void
  {
    WriteLine(s);
  }
  
  Main() : void
  {	
    System.Threading.Thread.CurrentThread.CurrentCulture = System.Globalization.CultureInfo.InvariantCulture;
    System.Threading.Thread.CurrentThread.CurrentUICulture = System.Globalization.CultureInfo.InvariantCulture;
    
    try
    {
      TestNotNullOrEmpty(null);
    }
    catch
    {
      | e is System.ArgumentException =>
        WriteLine(e.ParamName);

        def see = ". See ";
        def seeIndex = e.Message.IndexOf(see);

        def pos = "positive/";
        def posIndex  = e.Message.IndexOf(pos);

        // ArgumentException.Message renders ParamName differently per runtime (.NET
        // Framework: "\nParameter name: X" line; .NET Core 3+: " (Parameter 'X')" inline):
        // cut at the location suffix and print the name from e.ParamName instead.
        def rest = e.Message.Substring(posIndex);
        def endMark = ": .";
        def endIndex = rest.IndexOf(endMark);
        print (e.Message.Substring(0, seeIndex + see.Length) +
               rest.Substring(0, endIndex + endMark.Length) + "\n");
        print ("Parameter name: " + e.ParamName + "\n");
    }

    try
    {
      TestNotNullOrEmpty("");
    }
    catch
    {
      | e is System.ArgumentException =>
        WriteLine(e.ParamName);

        def see = ". See ";
        def seeIndex = e.Message.IndexOf(see);

        def pos = "positive/";
        def posIndex  = e.Message.IndexOf(pos);

        // Same per-runtime normalization as above.
        def rest = e.Message.Substring(posIndex);
        def endMark = ": .";
        def endIndex = rest.IndexOf(endMark);
        print (e.Message.Substring(0, seeIndex + see.Length) +
               rest.Substring(0, endIndex + endMark.Length) + "\n");
        print ("Parameter name: " + e.ParamName + "\n");
    }
    
    // Must not throw
    TestNotNullOrEmpty("a");
  }
}

/*
BEGIN-OUTPUT
s
The ``NotNullOrEmpty'' contract of parameter ``s'' has been violated. See positive/notnullorempty.n:7:39:7:40: .
Parameter name: s
s
The ``NotNullOrEmpty'' contract of parameter ``s'' has been violated. See positive/notnullorempty.n:7:39:7:40: .
Parameter name: s
a
END-OUTPUT
*/