
ncc/testsuite/positive/lexer1.n eol=lf

# Legacy VS2010-era engine sources are stored with CRLF endings (the repo does
# not normalize: core.autocrlf=false).  Declare CR-at-EOL part of the line
# terminator there so `git diff --check` flags real trailing whitespace only,
# instead of every added line.
VsIntegration/** whitespace=cr-at-eol

# Same story for the other legacy trees touched by the port (WP-N3): compiler
# sources, the Linq macro library and the testsuite are CRLF/LF mixed per file;
# on the CRLF ones every added line would otherwise trip `git diff --check`.
# The attribute only exempts the CR itself -- real trailing spaces still flag.
ncc/** whitespace=cr-at-eol
Linq/** whitespace=cr-at-eol
testsuite/** whitespace=cr-at-eol

# The root README is an upstream CRLF file; the WP-O1 port section keeps its
# line endings, so exempt the CR there too.
/README.md whitespace=cr-at-eol