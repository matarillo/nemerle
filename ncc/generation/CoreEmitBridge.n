using System;
using System.IO;
using System.Reflection;

namespace Nemerle.Compiler
{
  /**
   * Bridge to Nemerle.CoreEmit.dll -- the CoreCLR-only emission helper assembly.
   *
   * ncc's sources are compiled by the net4-era bootstrap compiler against the net4
   * BCL only, so this file (like the rest of ncc) can never reference
   * System.Reflection.Emit.PersistedAssemblyBuilder, System.Reflection.Metadata, or
   * any other CoreCLR-only type directly -- doing so would fail to *compile*, not
   * merely fail at run time. All such CoreCLR-only logic instead lives in
   * Nemerle.CoreEmit.dll (dotnet-port\Nemerle.CoreEmit, built separately for
   * net10.0) and is loaded + invoked purely through reflection, and only when
   * actually running on CoreCLR.
   *
   * IsCoreClr is the single runtime-detection point used throughout the emission
   * layer (HierarchyEmitter.n) to pick between the original .NET-Framework-only
   * Reflection.Emit backend and this bridge.
   */
  internal module CoreEmitBridge
  {
    public IsCoreClr : bool =
      System.Type.GetType ("System.Reflection.Emit.PersistedAssemblyBuilder, System.Reflection.Emit", false) != null;

    private mutable helper_type          : System.Type;
    private mutable create_builder_mi     : MethodInfo;
    private mutable create_run_builder_mi : MethodInfo;
    private mutable save_mi               : MethodInfo;
    private mutable attr_blob_type        : System.Type;
    private mutable create_attr_mi        : MethodInfo;
    private mutable set_asm_attr_mi       : MethodInfo;

    private EnsureLoaded () : void
    {
      when (helper_type == null)
      {
        def compilerDir = Path.GetDirectoryName (Assembly.GetExecutingAssembly ().Location);
        def helperPath  = Path.Combine (compilerDir, "Nemerle.CoreEmit.dll");
        def asm =
          try { Assembly.LoadFrom (helperPath) }
          catch {
            | e => Message.FatalError ($"could not load the CoreCLR emission helper `$helperPath': $(e.Message)")
          };
        helper_type            = asm.GetType ("Nemerle.CoreEmit.Emitter", true);
        create_builder_mi      = helper_type.GetMethod ("CreateBuilder");
        create_run_builder_mi  = helper_type.GetMethod ("CreateRunBuilder");
        save_mi                = helper_type.GetMethod ("Save");
        attr_blob_type         = asm.GetType ("Nemerle.CoreEmit.AttributeBlob", true);
        create_attr_mi         = attr_blob_type.GetMethod ("Create");
        set_asm_attr_mi        = helper_type.GetMethod ("SetAssemblyCustomAttribute");
      }
    }

    /** Persisted (savable) dynamic assembly builder -- replaces
        AppDomain.DefineDynamicAssembly(..., AssemblyBuilderAccess.Save, ...). */
    public CreateBuilder (name : AssemblyName) : System.Reflection.Emit.AssemblyBuilder
    {
      EnsureLoaded ();
      create_builder_mi.Invoke (null, array [name : object]) :> System.Reflection.Emit.AssemblyBuilder
    }

    /** Run-only dynamic assembly builder -- used for -compile-to-memory. */
    public CreateRunBuilder (name : AssemblyName) : System.Reflection.Emit.AssemblyBuilder
    {
      EnsureLoaded ();
      create_run_builder_mi.Invoke (null, array [name : object]) :> System.Reflection.Emit.AssemblyBuilder
    }

    /** Saves a builder created by CreateBuilder to disk (GenerateMetadata + ManagedPEBuilder
        recipe); see Nemerle.CoreEmit.Emitter.Save for the exact contract. When emitDebug is
        true, a standalone Portable PDB is written next to outputPath and referenced from
        the PE's debug directory (ncc -debug). win32ResourceFile (ncc -win32-resource), when
        non-null, is converted from RES to a .rsrc PE section by
        Nemerle.CoreEmit.ResFileResourceSection. linkedResources ("name|absoluteFilePath"
        pairs, ncc -linkres) are written as File+ManifestResource metadata rows -- see
        Emitter.Save's doc comment for the CoreCLR GetManifestResourceInfo caveat. */
    public Save (ab : System.Reflection.Emit.AssemblyBuilder, outputPath : string, entryPoint : MethodInfo,
                 isWinexe : bool, embeddedResources : array [string], emitRuntimeConfig : bool,
                 emitDebug : bool, win32ResourceFile : string, linkedResources : array [string]) : void
    {
      EnsureLoaded ();
      _ = save_mi.Invoke (null, array [ab : object, outputPath, entryPoint, isWinexe, embeddedResources, emitRuntimeConfig, emitDebug, win32ResourceFile, linkedResources]);
    }

    /** CoreCLR-only: builds a CustomAttributeBuilder that tolerates locally-defined
        (still-being-compiled TypeBuilder) enum types among the attribute's constructor
        argument / named property / named field types. The persisted TypeBuilderImpl lacks
        the enum special case in UnderlyingSystemType that both net4 TypeBuilder and
        CoreCLR's own RuntimeTypeBuilder have, so the public CustomAttributeBuilder
        constructor throws ArgumentException("Constant does not match the defined type.")
        for any such attribute usage (see dotnet-port\docs\15-attributes01-diagnosis.md). Falls
        back to the normal validated constructor when no local enum is involved. */
    public CreateAttributeBuilder (ctor : ConstructorInfo, ctorArgs : array [object],
                                    props : array [PropertyInfo], propVals : array [object],
                                    fields : array [FieldInfo], fieldVals : array [object])
        : System.Reflection.Emit.CustomAttributeBuilder
    {
      EnsureLoaded ();
      create_attr_mi.Invoke (null, array [ctor : object, ctorArgs, props, propVals, fields, fieldVals])
        :> System.Reflection.Emit.CustomAttributeBuilder
    }

    /** CoreCLR-only: applies an assembly-level custom attribute, routing around a
        PersistedAssemblyBuilder bug where AssemblyBuilder.SetCustomAttribute corrupts the
        saved PE when the attribute's constructor belongs to a TypeBuilder defined in the
        same assembly (verified independently of Nemerle -- see
        dotnet-port\docs\17-resources-fixes-log.md and Nemerle.CoreEmit.Emitter.
        SetAssemblyCustomAttribute's doc comment). Attributes whose constructor is external
        (already-compiled) are applied immediately as before; local-constructor ones are
        deferred and flushed by Nemerle.CoreEmit.Emitter.Save after GenerateMetadata(). Use
        this instead of calling `ab.SetCustomAttribute` directly for every assembly-level
        attribute on the CoreCLR path. */
    public SetAssemblyCustomAttribute (ab : System.Reflection.Emit.AssemblyBuilder,
                                        attr : System.Reflection.Emit.CustomAttributeBuilder) : void
    {
      EnsureLoaded ();
      _ = set_asm_attr_mi.Invoke (null, array [ab : object, attr]);
    }

    // NOTE: public-key-from-.snk extraction (formerly GetPublicKeyFromSnk here, invoked
    // via reflection into Nemerle.CoreEmit.dll) moved to ncc\misc\SnkUtils.n as plain
    // Nemerle code: the CAPI blob parse needs no CoreCLR-only API (just byte manipulation
    // + SHA1, both available unchanged on CLR4), so it runs identically on both runtimes
    // and needs no CoreEmitBridge/reflection indirection at all. See LibraryReference.n's
    // GetIsFriend and CustomAttribute.n's set_assembly_key_core.
  }
}
