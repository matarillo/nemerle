<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ComputationExpressions port spike: headless stand-in for the two WinForms consumers.
    See Main.n. Console app, so unlike them it can actually be run - and compared against the
    CLR4 toolchain.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNemerleCompileItems>false</EnableDefaultNemerleCompileItems>
    <UseAppHost>false</UseAppHost>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <NemerleCompile Include="Main.n" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nemerle.ComputationExpressions\Nemerle.ComputationExpressions.nproj" />
    <ProjectReference Include="..\Nemerle.ComputationExpressions.Macros\Nemerle.ComputationExpressions.Macros.nproj"
                      OutputItemType="NemerleMacroReference"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\msbuild\Nemerle.Core.targets" />

</Project>
