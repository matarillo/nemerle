<Project>
  <!--
    WP-A3 (in-process MSBuild task) built on top of the WP-I2 (task 3) PoC: lets an ordinary
    SDK-style project (`<Project Sdk="Microsoft.NET.Sdk">`) compile Nemerle (.n) sources
    in-process through Nemerle.Compiler.dll's ManagerClass API (dotnet-port\
    Nemerle.Compiler.Hosting + dotnet-port\Nemerle.MSBuild.Tasks), driven by plain
    `dotnet build`, with structured file/line/col diagnostics (Log.LogError/LogWarning) instead
    of `<Exec>`+stdout text scraping. See dotnet-port\20-inproc-task-plan.md /
    dotnet-port\20-inproc-task-log.md for the design and dotnet-port\DISTRIBUTION.md for the
    original PoC writeup this supersedes.

    Consuming project shape (see dotnet-port\samples\HelloCore\HelloCore.nproj):
      Project Sdk="Microsoft.NET.Sdk"
        PropertyGroup
          OutputType: Exe
          TargetFramework: net10.0
          EnableDefaultCompileItems: false   (Nemerle .n sources are NOT C#; keep the
                                              SDK's own **/*.cs globbing out of the
                                              picture entirely)
          UseAppHost: false                  (ncc emits a managed PE directly runnable
                                              via "dotnet <dll>", verified in
                                              pack-tool.ps1; no native apphost needed)
          GenerateDependencyFile: false      (no PackageReference/ProjectReference
                                              graph to describe)
        ItemGroup
          NemerleCompile Include="*.n"
        Import Project="...\Nemerle.Core.targets"

    Design: this does NOT try to be a full MSBuild-task port of the legacy Ncc ToolTask
    (tools\msbuild-task\MSBuildTask.cs: out-of-proc ManagedCompiler subclass; see
    dotnet-port\02-build-flow.md section 3; that class derives from
    Microsoft.Build.Tasks.ManagedCompiler, which does not exist in
    Microsoft.Build.Tasks.Core on modern/SDK-style MSBuild). Instead it overrides the single
    well-known MSBuild extension point real compilers hook (`CoreCompile`, called by the SDK's
    own `Compile`/`Build` chain: exactly what the legacy Ncc task did by overriding
    `CoreCompile` via `<UsingTask TaskName="...Ncc">` + retargeted `Microsoft.Common.targets`)
    with the `NccCompile` task below. `@(IntermediateAssembly)` (the exact output path
    csc/fsc/vbc's own CoreCompile would have produced) is reused verbatim so every downstream
    SDK target (CopyFilesToOutputDirectory, GenerateBuildRuntimeConfigurationFiles, Clean, etc.)
    keeps working unmodified.

    Escape hatch: pass -p:NemerleUseExec=true to fall back to the original out-of-process
    `<Exec dotnet ncc.dll ...>` path (kept verbatim below) if the in-process task assembly is
    missing, misbehaves, or you need old-style stdout text output for some tooling.
  -->

  <PropertyGroup>
    <!-- Where dotnet-port\pack-tool.ps1 wrote the runnable "dotnet ncc" layout
         (ncc.dll + Nemerle*.dll + Nemerle.Compiler.Hosting.dll + msbuild-task\). Override
         with -p:NccLayoutDir=... -->
    <NccLayoutDir Condition="'$(NccLayoutDir)' == ''">$(MSBuildThisFileDirectory)..\dist\ncc\</NccLayoutDir>
    <NccDll>$(NccLayoutDir)ncc.dll</NccDll>
    <!-- In-process task assembly built by dotnet-port\Nemerle.MSBuild.Tasks, placed here by
         pack-tool.ps1. Only needed/validated when NemerleUseExec != true. -->
    <NemerleTaskAssembly Condition="'$(NemerleTaskAssembly)' == ''">$(NccLayoutDir)msbuild-task\Nemerle.MSBuild.Tasks.dll</NemerleTaskAssembly>
    <!-- "exe" or "library": mirrors ncc's own -target: values, defaulted from OutputType
         the same way Nemerle.MSBuild.targets/the legacy .nproj files do. -->
    <NemerleTargetType Condition="'$(NemerleTargetType)' == '' AND '$(OutputType)' == 'Exe'">exe</NemerleTargetType>
    <NemerleTargetType Condition="'$(NemerleTargetType)' == ''">library</NemerleTargetType>
    <!-- ncc emits a standalone Portable PDB (WP-E, dotnet-port\14-pdb-log.md) at <out>.pdb
         when -debug is passed, i.e. at $(IntermediateOutputPath)$(TargetName).pdb, exactly
         where the SDK's @(_DebugSymbolsIntermediatePath) already points, so once ncc writes
         it there the common targets copy it to $(OutDir) and clean it with no extra wiring.
         Emit symbols unless the project turned them off (DebugType=none / DebugSymbols=false);
         the SDK defaults DebugType=portable and DebugSymbols=true for both Debug and Release. -->
    <NemerleEmitDebug Condition="'$(DebugType)' != 'none' AND '$(DebugType)' != 'None' AND '$(DebugSymbols)' != 'false'">true</NemerleEmitDebug>
    <NemerleEmitDebug Condition="'$(NemerleEmitDebug)' == ''">false</NemerleEmitDebug>
    <!-- Exec-path-only rendering of the same decision, kept for the -p:NemerleUseExec=true
         fallback below. -->
    <NemerleDebugSwitch Condition="'$(NemerleEmitDebug)' == 'true'">-debug</NemerleDebugSwitch>
    <!-- Extra ncc CLI switches (whitespace-separated, verbatim), for both the in-process task
         and the Exec fallback, e.g. -p:NemerleAdditionalOptions="-nowarn:10003 -checked". -->
    <NemerleAdditionalOptions Condition="'$(NemerleAdditionalOptions)' == ''"></NemerleAdditionalOptions>
    <!-- The SDK's "ref assembly" optimization (ProduceReferenceAssembly, on by default)
         expects CoreCompile to additionally emit a stripped-down reference assembly under
         obj\...\refint\; that is a Roslyn (/refout:)-specific feature ncc has no
         equivalent of, so turn it off for Nemerle.Core.targets-based projects. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Only registered (and only needs to resolve) when actually used: the Condition is
       evaluated before MSBuild needs the task type to exist, so -p:NemerleUseExec=true works
       even if Nemerle.MSBuild.Tasks.dll/Nemerle.Compiler.Hosting.dll are missing entirely. -->
  <UsingTask TaskName="Nemerle.MSBuild.Tasks.NccCompile"
             AssemblyFile="$(NemerleTaskAssembly)"
             Condition="'$(NemerleUseExec)' != 'true'" />

  <Target Name="NemerleEnsureLayout" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(NccDll)')"
           Text="NccLayoutDir ($(NccLayoutDir)) does not contain ncc.dll: run dotnet-port\pack-tool.ps1 first (or pass -p:NccLayoutDir=&lt;path&gt;)." />
    <Error Condition="'$(NemerleUseExec)' != 'true' AND !Exists('$(NemerleTaskAssembly)')"
           Text="NemerleTaskAssembly ($(NemerleTaskAssembly)) not found: run dotnet-port\pack-tool.ps1 (which builds dotnet-port\Nemerle.MSBuild.Tasks) first, or pass -p:NemerleUseExec=true to use the out-of-process compiler instead." />
    <Error Condition="'@(NemerleCompile)' == ''"
           Text="No @(NemerleCompile) items -- add &lt;NemerleCompile Include=&quot;*.n&quot; /&gt; (or similar) to the project." />
  </Target>

  <!-- Using a non-".csproj" project extension (".nproj") deliberately: the .NET SDK
       selects its language-specific target set (Microsoft.CSharp.CurrentVersion.targets
       etc.) from $(MSBuildProjectExtension), and that set is imported by the SDK's own
       implicit trailing "Sdk.targets" import, i.e. AFTER any explicit <Import> a project
       body writes, so a ".csproj"-named project always has ITS csc-based CoreCompile
       win over ours (last same-named target definition wins in MSBuild). ".nproj" sidesteps
       the conflict entirely (no competing CoreCompile is ever imported) at the cost of
       losing a couple of small pieces of infrastructure that are normally supplied by
       the language-specific targets; CreateManifestResourceNames is the one this PoC has
       needed to stub out so far (called unconditionally from the SDK's own Compile chain;
       harmless no-op here since no <EmbeddedResource> items are used by NemerleCompile-based
       projects). -->
  <Target Name="CreateManifestResourceNames" Condition="'$(MSBuildProjectExtension)' != '.csproj'" />

  <!-- Overrides the SDK's built-in CoreCompile (normally Csc). @(IntermediateAssembly) is
       already computed by the common targets imported ahead of this file (Sdk.targets), to
       the same path csc would have written; reusing it verbatim keeps every downstream
       target (copy-to-output, runtimeconfig/deps generation, Clean, incremental up-to-date
       checks via Inputs/Outputs below) working exactly as the SDK expects. -->
  <Target Name="CoreCompile"
          Inputs="@(NemerleCompile);@(ReferencePath);@(NemerleMacroReference);$(NccDll);$(NemerleTaskAssembly)"
          Outputs="@(IntermediateAssembly)">
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <!-- Pass this project's own ProjectReference/PackageReference outputs to ncc as -ref:.
         The .NET SDK's ResolveAssemblyReferences populates @(ReferencePath) with BOTH those
         and the framework ref-pack facades (Microsoft.NETCore.App.Ref, %(FrameworkReferenceName)
         = Microsoft.NETCore.App); the facades are excluded here because their GetExportedTypes()
         is empty and ncc already auto-resolves the real shared framework itself
         (LoadCoreStdlibReferences in ncc\passes.n). What is left is project/package references,
         which have an empty %(FrameworkReferenceName). -->
    <ItemGroup>
      <_NemerleUserReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == ''" />
    </ItemGroup>

    <!-- Macro-only project references (compile-time-only, mirrors the legacy .nproj's
         MacroProjectReference/"-macros:" split; see tools\msbuild-task\Nemerle.MSBuild.targets
         and MSBuildTask.cs). A consuming project writes an ordinary ProjectReference with
         OutputItemType="NemerleMacroReference" ReferenceOutputAssembly="false": the SDK's own
         ResolveProjectReferences (Microsoft.Common.CurrentVersion.targets) still builds the
         referenced project first (build-order dependency preserved) but emits its output path
         ONLY into @(NemerleMacroReference), not into @(ReferencePath), so it is never added
         to this project's -ref: list, never copied to the output directory, and its types
         never enter scope; ncc loads its macros only (LoadPluginsFrom(loadMacros = true) via
         Options.MacrosToLoad, ncc\passes.n). -->
    <NccCompile Condition="'$(NemerleUseExec)' != 'true'"
                Sources="@(NemerleCompile)"
                References="@(_NemerleUserReference)"
                MacroReferences="@(NemerleMacroReference)"
                OutputAssembly="%(IntermediateAssembly.FullPath)"
                TargetType="$(NemerleTargetType)"
                EmitDebug="$(NemerleEmitDebug)"
                AdditionalOptions="$(NemerleAdditionalOptions)"
                NccLayoutDir="$(NccLayoutDir)" />

    <!-- Escape hatch: original out-of-process path, byte-for-byte the same command line this
         target used before WP-A3 (plus -macros: for NemerleMacroReference, added alongside the
         in-process path above). ncc auto-resolves the standard reference set (the shared
         framework's real split BCL assemblies + this layout's Nemerle.dll) on CoreCLR since
         the LoadCoreStdlibReferences change in ncc\passes.n, so no -from-file:ncc.default.rsp
         is needed here either. -->
    <Exec Condition="'$(NemerleUseExec)' == 'true'"
          Command="dotnet &quot;$(NccDll)&quot; -target:$(NemerleTargetType) $(NemerleDebugSwitch) -out:&quot;%(IntermediateAssembly.FullPath)&quot; @(_NemerleUserReference->'-ref:&quot;%(FullPath)&quot;', ' ') @(NemerleMacroReference->'-macros:&quot;%(FullPath)&quot;', ' ') $(NemerleAdditionalOptions) @(NemerleCompile->'&quot;%(FullPath)&quot;', ' ')"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- Ordinary Nemerle programs reference Nemerle.dll (and, if they use macros at their own
       call sites, Nemerle.Macros.dll/Nemerle.Compiler.dll) at RUN time; .NET's assembly
       probing only looks beside the entry assembly / in the shared framework (no GAC),
       see pack-tool.ps1's header comment / 18-testsuite-log.md section 3b for the same gap
       in the test harness. Copy them next to the produced assembly and record the
       destinations in @(FileWrites) so `dotnet clean` removes them again. Runs right after
       CopyFilesToOutputDirectory (which creates $(OutDir) and copies the main assembly/pdb)
       and BEFORE IncrementalClean, which is the target that snapshots @(FileWrites) into the
       clean file; the previous version ran AfterTargets="Build" (after IncrementalClean) and
       off the FileWrites path, so these dlls were left behind in bin\ by clean. -->
  <Target Name="NemerleCopyRuntimeAssemblies" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(OutDir)' != ''">
    <ItemGroup>
      <_NemerleRuntimeDll Include="$(NccLayoutDir)Nemerle.dll;$(NccLayoutDir)Nemerle.Compiler.dll;$(NccLayoutDir)Nemerle.Macros.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_NemerleRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

</Project>
