  <!--
    IIdeEngine (IEngine.n, unmodified/shared with the legacy VS build) declares
    CreateCodeCompileUnit/MergeCodeCompileUnit/BeginMergeCodeCompileUnit: Nemerle.VisualStudio's
    Forms-designer CodeDom round-trip (Project\NemerleFileNodeCodeDomProvider.cs) calls these
    through the IIdeEngine interface type, so removing them from the interface would break that
    legacy VS project's compile even though this headless/core build never needs them. Their real
    implementations (Engine-CreateCodeCompileUnit.n/Engine-MergeCodeCompileUnit.n) go through
    FormCodeDomParser (CodeDom\NemerleCodeParser.n and friends), which genuinely needs
    System.Drawing/System.Windows.Forms for designer-position metadata, so those stay excluded.
    But the three TYPES in the interface signatures (CreateCodeCompileUnitAsyncRequest, FormChanges,
    MergeCodeCompileUnitAsyncRequest) only use System.CodeDom, not WinForms, so they can be compiled
    here as-is; CodeDomStubs.n (below) then satisfies the interface with NotSupportedException
    bodies, which is honest for a host that never calls them (WP-K's headless test suite doesn't).
  -->
  <ItemGroup>
    <NemerleCompile Include="..\..\..\VsIntegration\Nemerle.Compiler.Utils\CodeDom\FormChanges.n" />
    <NemerleCompile Include="..\..\..\VsIntegration\Nemerle.Compiler.Utils\Async\AsyncRequest\CreateCodeCompileUnitAsyncRequest.n" />
    <NemerleCompile Include="..\..\..\VsIntegration\Nemerle.Compiler.Utils\Async\AsyncRequest\MergeCodeCompileUnitAsyncRequest.n" />
    <NemerleCompile Include="CodeDomStubs.n" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to match the installed/used Microsoft.NETCore.App runtime (dotnet-port\
         build-stage2-core.ps1 resolves the same 10.0.9 shared-framework directory for its
         -ref: paths), so this package gets its native net10.0 lib assets instead of falling
         back to an older TFM's compat shim. -->
    <PackageReference Include="System.CodeDom" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Nemerle.Compiler">
      <HintPath>$(MSBuildThisFileDirectory)..\..\dist\ncc\Nemerle.Compiler.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Nemerle.Macros">
      <HintPath>$(MSBuildThisFileDirectory)..\..\dist\ncc\Nemerle.Macros.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\msbuild\Nemerle.Core.targets" />

</Project>
