<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PEG port spike, minimal case: grammars written for this spike rather than taken from
    snippets\, with no extensible rules, so a failure here points at the core PEG code path
    rather than at the [Extensible] machinery that CalcSpike also exercises.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNemerleCompileItems>false</EnableDefaultNemerleCompileItems>
    <UseAppHost>false</UseAppHost>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <NemerleCompile Include="Simple.n" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nemerle.Peg\Nemerle.Peg.nproj" />
    <ProjectReference Include="..\Nemerle.Peg.Macros\Nemerle.Peg.Macros.nproj"
                      OutputItemType="NemerleMacroReference"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\msbuild\Nemerle.Core.targets" />

</Project>
