<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PEG port spike: driver for the JSON port. Based on
    snippets\peg-parser\Json\ConsoleDemo\Main.n, but with the trailing ReadKey removed (this
    has to run unattended) and round-trip assertions added, so a run either prints all "ok"
    or reports which case diverged.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNemerleCompileItems>false</EnableDefaultNemerleCompileItems>
    <UseAppHost>false</UseAppHost>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <NemerleCompile Include="Main.n" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nemerle.Json\Nemerle.Json.nproj" />
    <ProjectReference Include="..\Nemerle.Json.Macros\Nemerle.Json.Macros.nproj"
                      OutputItemType="NemerleMacroReference"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\msbuild\Nemerle.Core.targets" />

</Project>
