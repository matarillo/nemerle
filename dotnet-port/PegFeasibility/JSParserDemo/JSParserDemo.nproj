<Project Sdk="Microsoft.NET.Sdk">

  <!-- PEG port spike: runs the ported JavaScript parser against real snippets. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNemerleCompileItems>false</EnableDefaultNemerleCompileItems>
    <UseAppHost>false</UseAppHost>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <NemerleCompile Include="Main.n" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JSParser\JSParser.nproj" />
    <ProjectReference Include="..\Nemerle.Peg\Nemerle.Peg.nproj" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\msbuild\Nemerle.Core.targets" />

</Project>
