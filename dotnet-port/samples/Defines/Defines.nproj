<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WP-M1 build/IDE parity fixture (dotnet-port\29-devenv2-plan.md, acceptance
    criterion 1).  defines.n has an #if CUSTOM_FEATURE / #else split where the
    #else branch is a deliberate type error, so whether the source compiles is
    decided entirely by the CUSTOM_FEATURE preprocessor symbol.

    CUSTOM_FEATURE is appended to $(DefineConstants) by default, so:
      dotnet build Defines.nproj                      -> success (clean #if branch)
      dotnet build Defines.nproj -p:EnableCustom=false -> error   (#else branch)
    The IDE sees the same thing: with the project applied (CUSTOM_FEATURE on) the
    file is clean; as a loose file (default DEBUG;TRACE, no CUSTOM_FEATURE) it errors.

    Prerequisite: dotnet-port\dist\ncc must exist (pwsh dotnet-port\pack-tool.ps1).
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants Condition="'$(EnableCustom)' != 'false'">$(DefineConstants);CUSTOM_FEATURE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <NemerleCompile Include="defines.n" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\msbuild\Nemerle.Core.targets" />

</Project>
